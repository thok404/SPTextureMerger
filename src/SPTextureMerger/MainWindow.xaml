<Window x:Class="SPTextureMerger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SPTextureMerger"
        Width="1280"
        Height="820"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        SourceInitialized="Window_SourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="#70FFFFFF"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#18FFFFFF"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="SPTextureMerger"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,7,12,7">
                    <Button Content="_"
                            Width="38"
                            Style="{StaticResource InlineButton}"
                            Click="Minimize_Click" />
                    <Button Content="□"
                            Width="38"
                            Style="{StaticResource InlineButton}"
                            Click="Maximize_Click" />
                    <Button Content="X"
                            Width="38"
                            Style="{StaticResource InlineButton}"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="22,18,22,10"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Effect="{StaticResource GlassShadow}">
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Content="+ Row"
                                Style="{StaticResource ToolbarButton}"
                                Click="AddRow_Click" />
                        <Button Content="+ Column"
                                Style="{StaticResource ToolbarButton}"
                                Click="AddColumn_Click" />
                        <Button Content="Open Config"
                                Style="{StaticResource ToolbarButton}"
                                Click="OpenProject_Click" />
                        <Button Content="Save Config"
                                Style="{StaticResource ToolbarButton}"
                                Click="SaveProject_Click" />
                    </WrapPanel>

                    <Grid MinWidth="420" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="94" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Output"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,8,0" />
                        <TextBox x:Name="OutputBaseNameTextBox"
                                 Grid.Column="1"
                                 TextChanged="OutputBaseName_TextChanged"
                                 VerticalAlignment="Center"
                                 MinHeight="38" />
                        <Button Grid.Column="2"
                                Content="Output Folder"
                                Style="{StaticResource ToolbarButton}"
                                Margin="12,4,8,4"
                                Click="ChooseOutputDirectory_Click" />
                        <TextBlock x:Name="OutputDirectoryTextBlock"
                                   Grid.Column="3"
                                   Foreground="{StaticResource TextBrush}"
                                   Opacity="0.82"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MinWidth="120"
                                   Margin="0,0,14,0" />
                        <TextBlock Grid.Column="4"
                                   Text="Format"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="OutputFormatComboBox"
                                  Grid.Column="5"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OutputFormat_SelectionChanged">
                            <ComboBoxItem Content="PNG" Tag="png" IsSelected="True" />
                            <ComboBoxItem Content="TIFF" Tag="tiff" />
                        </ComboBox>
                        <Button x:Name="MergeButton"
                                Grid.Column="6"
                                Content="Merge"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="112"
                                Margin="12,4,0,4"
                                Click="Merge_Click" />
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2" Margin="22,10,22,10">
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="22"
                        Effect="{StaticResource GlassShadow}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                        <Grid x:Name="TextureGrid" />
                    </ScrollViewer>
                </Border>

                <TextBlock x:Name="EmptyStateTextBlock"
                           Text="Add rows and columns, then drop masks and textures into the slots."
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Visibility="Collapsed" />
            </Grid>

            <Grid Grid.Row="3" Margin="24,0,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="MergeProgressBar"
                             Grid.Column="1"
                             Height="6"
                             IsIndeterminate="False"
                             Visibility="Collapsed"
                             VerticalAlignment="Center" />
            </Grid>

            <StackPanel x:Name="ToastHost"
                        Grid.RowSpan="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,58"
                        IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
